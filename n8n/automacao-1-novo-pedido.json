{
  "name": "SmartLar — 1. Novo pedido",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smartlar-novo-pedido",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111101",
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "smartlar-novo-pedido"
    },
    {
      "parameters": {
        "jsCode": "const SUPABASE_URL = 'https://SEU-PROJETO.supabase.co';\nconst SERVICE_ROLE = 'COLE_A_SERVICE_ROLE_AQUI';\nconst EMAIL_DESTINO = 'COLE_O_EMAIL_DO_RAFAEL';\n\nconst raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst record = body.record || {};\n\nif (body.type !== 'INSERT' || record.status !== 'orcamento' || !record.id) {\n  return [];\n}\n\nreturn [{\n  json: {\n    pedido_id: record.id,\n    supabase_url: String(SUPABASE_URL).replace(/\\/$/, ''),\n    service_role: SERVICE_ROLE,\n    email_destino: EMAIL_DESTINO,\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111102",
      "name": "Filtrar orcamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111103",
      "name": "Aguardar itens",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ],
      "webhookId": "smartlar-aguardar-itens"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Filtrar orcamento').first().json.supabase_url }}/rest/v1/pedidos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Filtrar orcamento').first().json.pedido_id }}"
            },
            {
              "name": "select",
              "value": "id,numero,valor_total,created_at,status,forma_pagamento,clientes(nome)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Filtrar orcamento').first().json.service_role }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Filtrar orcamento').first().json.service_role }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111104",
      "name": "Buscar pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "function reais(valor) {\n  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(valor) || 0);\n}\nfunction quando(iso) {\n  if (!iso) return 'sem data';\n  return new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }).format(new Date(iso));\n}\nfunction numeroPedido(numero) {\n  return '#' + String(numero).padStart(3, '0');\n}\n\nconst payload = $input.first().json;\nconst lista = Array.isArray(payload) ? payload : [payload];\nconst pedido = lista[0];\nif (!pedido || !pedido.id) {\n  throw new Error('Pedido não encontrado depois do insert. O total pode ainda não ter sido calculado.');\n}\nconst cliente = pedido.clientes && pedido.clientes.nome ? pedido.clientes.nome : 'Cliente não identificado';\nconst numero = numeroPedido(pedido.numero);\nconst valor = reais(pedido.valor_total);\n\nreturn [{\n  json: {\n    para: $('Filtrar orcamento').first().json.email_destino,\n    assunto: 'Novo orçamento ' + numero + ' — ' + cliente + ' — ' + valor,\n    corpo: [\n      'Entrou um orçamento novo.',\n      '',\n      'Pedido: ' + numero,\n      'Cliente: ' + cliente,\n      'Valor: ' + valor,\n      'Data: ' + quando(pedido.created_at),\n    ].join('\\n'),\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111105",
      "name": "Montar resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.para }}",
        "subject": "={{ $json.assunto }}",
        "emailType": "text",
        "message": "={{ $json.corpo }}",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111106",
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1400,
        220
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst mensagem = (item && item.error && item.error.message) || item.message || JSON.stringify(item);\nthrow new Error('Automação 1 falhou e não enviou o e-mail do orçamento: ' + mensagem);"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111107",
      "name": "Registrar falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        420
      ]
    }
  ],
  "connections": {
    "Webhook Supabase": {
      "main": [
        [
          {
            "node": "Filtrar orcamento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar orcamento": {
      "main": [
        [
          {
            "node": "Aguardar itens",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aguardar itens": {
      "main": [
        [
          {
            "node": "Buscar pedido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar pedido": {
      "main": [
        [
          {
            "node": "Montar resumo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Registrar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar resumo": {
      "main": [
        [
          {
            "node": "Enviar e-mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar e-mail": {
      "main": [
        [],
        [
          {
            "node": "Registrar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
