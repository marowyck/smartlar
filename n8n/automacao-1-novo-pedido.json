{
  "name": "SmartLar — 1. Novo pedido",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smartlar-novo-pedido",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111101",
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "smartlar-novo-pedido"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SUPABASE_URL = 'https://SEU-PROJETO.supabase.co';\nconst SERVICE_ROLE = 'COLE_A_SERVICE_ROLE_AQUI';\n\nconst entrada = $input.first().json;\n\nreturn [{\n  json: {\n    ...entrada,\n    supabase_url: String(SUPABASE_URL).replace(/\\/$/, ''),\n    service_role: SERVICE_ROLE,\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111108",
      "name": "Configuracao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const entrada = $input.first().json;\nconst body = entrada.body && typeof entrada.body === 'object' ? entrada.body : entrada;\nconst record = body.record || {};\n\nif (body.type !== 'INSERT' || record.status !== 'orcamento' || !record.id) {\n  return [];\n}\n\nreturn [{\n  json: {\n    pedido_id: record.id,\n    supabase_url: entrada.supabase_url,\n    service_role: entrada.service_role,\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111102",
      "name": "Filtrar orcamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111103",
      "name": "Aguardar itens",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "webhookId": "smartlar-aguardar-itens"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.supabase_url }}/rest/v1/pedidos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json.pedido_id }}"
            },
            {
              "name": "select",
              "value": "id,numero,valor_total,created_at,status,forma_pagamento,clientes(nome,email)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.service_role }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.service_role }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111104",
      "name": "Buscar pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function reais(valor) {\n  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(valor) || 0);\n}\n\nfunction quando(iso, vazio) {\n  if (!iso) return vazio;\n  return new Intl.DateTimeFormat('pt-BR', {\n    dateStyle: 'short',\n    timeStyle: 'short',\n    timeZone: 'America/Sao_Paulo',\n  }).format(new Date(iso));\n}\n\nfunction numeroPedido(numero) {\n  return '#' + String(numero).padStart(3, '0');\n}\n\nfunction clienteDoPedido(pedido) {\n  const dados = pedido.clientes || {};\n  const nome = dados.nome || 'Cliente não identificado';\n  const email = String(dados.email || '').trim();\n  if (!email) throw new Error('O cliente ' + nome + ' não tem e-mail cadastrado.');\n  return { nome, email };\n}\n\nfunction primeiro(payload) {\n  const lista = Array.isArray(payload) ? payload : [payload];\n  return lista[0];\n}\n\nconst pedido = primeiro($input.first().json);\nif (!pedido || !pedido.id) {\n  throw new Error('Pedido não encontrado depois do insert. O total pode ainda não ter sido calculado.');\n}\n\nconst cliente = clienteDoPedido(pedido);\nconst numero = numeroPedido(pedido.numero);\nconst valor = reais(pedido.valor_total);\n\nreturn [{\n  json: {\n    para: cliente.email,\n    assunto: 'Orçamento ' + numero + ' — ' + valor,\n    corpo: [\n      'Olá, ' + cliente.nome + '.',\n      '',\n      'Seu orçamento foi registrado.',\n      '',\n      'Pedido: ' + numero,\n      'Valor: ' + valor,\n      'Data: ' + quando(pedido.created_at, 'sem data'),\n    ].join('\\n'),\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111105",
      "name": "Montar resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.para }}",
        "subject": "={{ $json.assunto }}",
        "emailType": "text",
        "message": "={{ $json.corpo }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111106",
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1560,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst mensagem = (item && item.error && item.error.message) || item.message || JSON.stringify(item);\nthrow new Error(\"Automação 1 não enviou o e-mail do orçamento: \" + mensagem);"
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111107",
      "name": "Registrar falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        500
      ]
    }
  ],
